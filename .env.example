# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Server only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# IANA zone used to display times on the dashboard. Storage stays UTC.
OWNER_TIME_ZONE=UTC

# Public URL of this app. Included in the Make notification payload.
APP_URL=http://localhost:3000

# Make scenario 1: custom webhook URL. Leave empty until the scenario exists.
MAKE_WEBHOOK_URL=
MAKE_WEBHOOK_SECRET=

# Make scenario 2 sends this as: Authorization: Bearer <secret>
MAKE_API_SECRET=replace-with-a-long-random-string
